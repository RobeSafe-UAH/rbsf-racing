<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rf2o_laser_odometry</name>
  <version>0.1.0</version>
  <description>
    Estimation of 2D odometry based on planar laser scans (RF2O, ICRA 2016). Vendored from
    MAPIRlab/rf2o_laser_odometry (ros2 branch, b38c68e) and ported to ROS 2 Jazzy; see
    PORTING.md.
  </description>

  <maintainer email="santimontieleu@gmail.com">RobeSafe (Universidad de Alcala)</maintainer>
  <author email="marianojt@uma.es">Mariano Jaimez</author>
  <author email="jgmonroy@uma.es">Javier G. Monroy</author>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/MAPIRlab/rf2o_laser_odometry</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>

  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
