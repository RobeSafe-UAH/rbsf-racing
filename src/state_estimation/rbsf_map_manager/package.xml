<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rbsf_map_manager</name>
  <version>0.1.0</version>
  <description>Known-map mapping slot of RBSF Racing: serves a track's map (rbsf_worlds track or a car-mapped session) on /map with nav2's map_server, publishing no TF.</description>
  <maintainer email="santimontieleu@gmail.com">santimontiel</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>rbsf_identity</exec_depend>
  <exec_depend>rbsf_worlds</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
