<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>range_libc</name>
  <version>0.1.0</version>
  <description>RangeLibc: fast 2D ray casting on occupancy grids (Bresenham, ray marching, CDDT, giant LUT) with Python bindings. Vendored from f1tenth/range_libc for the particle filter.</description>
  <maintainer email="santimontieleu@gmail.com">santimontiel</maintainer>
  <license>Apache-2.0</license>
  <author email="corey.walsh11@gmail.com">Corey H. Walsh</author>
  <url type="repository">https://github.com/f1tenth/range_libc</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>cython3</buildtool_depend>

  <build_depend>python3-dev</build_depend>
  <depend>python3-numpy</depend>
  <exec_depend>nav_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
